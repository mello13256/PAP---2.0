# =============================================================================
# MultiMind — configuração
# Copia este ficheiro para ".env" (na raiz do repositório) e preenche os valores.
# O ".env" está no .gitignore: NUNCA faças commit de chaves reais.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Chave usada para assinar os tokens de sessão. Gera uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em desenvolvimento, se ficar vazia, é gerada uma temporária a cada arranque.
SECRET_KEY=

# --- Base de dados -----------------------------------------------------------
# Vazio = SQLite em backend/data/multimind.db
# PostgreSQL (opcional): postgresql+asyncpg://user:pass@localhost:5432/multimind
DATABASE_URL=

# --- Fornecedores de LLM -------------------------------------------------------
# Deixa em branco os que não usas. Ver docs/decisoes-tecnicas.md (DT-01).

# OpenAI (pago)
OPENAI_API_KEY=

# Anthropic (pago)
ANTHROPIC_API_KEY=

# Ollama (local, gratuito) — https://ollama.com
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# GitHub Models (gratuito com limites) — token pessoal do GitHub
GITHUB_MODELS_TOKEN=

# Google Gemini (plano gratuito com limites)
GEMINI_API_KEY=

# Groq (plano gratuito com limites)
GROQ_API_KEY=
